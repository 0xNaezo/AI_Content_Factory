# Internal-only egress proxy (no published ports, only the n8n container can reach it).
# n8n calls http://egress:8081/tg/<method> and http://egress:8081/tgfile/<file_path>;
# the bot token is added here from env, so it never appears in n8n workflows, credentials or execution data.
{
	admin off
	auto_https off
}

:8081 {
	handle_path /tg/* {
		rewrite * /bot{$TELEGRAM_BOT_TOKEN}{uri}
		reverse_proxy https://api.telegram.org {
			header_up Host api.telegram.org
			transport http {
				dial_timeout 10s
				response_header_timeout 60s
			}
		}
	}
	handle_path /tgfile/* {
		rewrite * /file/bot{$TELEGRAM_BOT_TOKEN}{uri}
		reverse_proxy https://api.telegram.org {
			header_up Host api.telegram.org
		}
	}
	respond 404
}
