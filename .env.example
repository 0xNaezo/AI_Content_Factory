# Copy to .env via scripts/setup-env.sh (fills local secrets with random values). Never commit .env.

# --- Local secrets (generated) ---
POSTGRES_PASSWORD=
APP_OWNER_PASSWORD=
APP_N8N_PASSWORD=
APP_WEB_PASSWORD=
N8N_DB_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=acf
TELEGRAM_WEBHOOK_SECRET=
WEB_CMD_SECRET=
WEB_SESSION_SECRET=
# Prod: required, keep a copy outside DB backups. Dev: empty = key stored in the n8n volume.
N8N_ENCRYPTION_KEY=

# --- External services (fill in) ---
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
RESEND_API_KEY=

# --- n8n public API key (Settings -> n8n API) for scripts and n8n-mcp; export before starting Claude Code ---
N8N_API_KEY=

# --- URLs ---
# Public HTTPS base where Telegram and Resend reach n8n webhooks (a cloudflared tunnel in dev)
PUBLIC_N8N_URL=
PUBLIC_WEB_URL=http://localhost:3001
# Prod only (docker-compose.prod.yml): ACME account email and the host of PUBLIC_N8N_URL
ACME_EMAIL=
N8N_DOMAIN=
GENERIC_TIMEZONE=Europe/Moscow
