        1440,
        170
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "6098cff1-56e3-591c-80a5-b028c37dcb6d",
      "name": "Read feed",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [
        1680,
        340
      ],
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {}
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "id": "1c2baf65-eecb-5efc-8106-703f0531ee52",
      "name": "Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        340
      ],
      "parameters": {
        "jsCode": "const src = $('Source loop').first().json;\nconst all = $input.all().map((i) => i.json);\nconst error = all.length && all[0].error ? String(all[0].error.message ?? all[0].error).slice(0, 300) : null;\nconst items = error ? [] : all.filter((i) => i.title || i.link).sort((a, b) => String(b.isoDate || '').localeCompare(String(a.isoDate || ''))).slice(0, 20)\n  .map((i) => ({ guid: i.guid || i.id || i.link, title: i.title || '', link: i.link || null,\n                 summary: String(i.contentSnippet || i.content || i.summary || '').slice(0, 3000), published_at: i.isoDate || null }));\nreturn [{ json: { source_id: src.id, items, error } }];\n"
      }
    },
    {
      "id": "851917ea-226a-571a-aca7-552053be049b",
      "name": "New items?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2160,
        340
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "da19e67d-4021-5fc4-86c2-8e75d5c4febd",
              "leftValue": "={{ !!($json.items.length > 0) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "27fd1275-a184-5b9c-b4b1-2d93919055f4",
      "name": "AI input: item vectors",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        170
      ],
      "parameters": {
        "jsCode": "const c = $('Context').first().json.c; return { json: { route: 'embed', input: $json.items.map((i) => i.title + '. ' + i.summary), account_type: 'brand', brand_id: c.brand_id, job_id: $('Job').first().json.id } };\n",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "44a30b45-511f-5e06-bed0-2b09e322335e",
      "name": "AI: item vectors",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        2640,
        170
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "acfAiGateway0001",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "2ed8b265-d6df-5bff-837e-9ed8b140f535",
      "name": "Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        170
      ],
      "parameters": {
        "jsCode": "const brand = $('AI: brand vector').first().json.result;\nconst got = $('Items').first().json;\nconst vecs = $input.first().json.result;\nconst cos = (a, b) => { let d = 0, x = 0, y = 0; for (let i = 0; i < a.length; i++) { d += a[i] * b[i]; x += a[i] * a[i]; y += b[i] * b[i]; } return d / (Math.sqrt(x * y) || 1); };\nreturn [{ json: { source_id: got.source_id, error: null, items: got.items.map((it, i) => ({ ...it,\n  embedding: Array.isArray(vecs?.[i]) ? JSON.stringify(vecs[i]) : null, relevance: Array.isArray(vecs?.[i]) ? Number(cos(brand, vecs[i]).toFixed(4)) : null })) } }];\n"
      }
    },
    {
      "id": "e27d068c-13fb-5b40-ac63-8d683bd5c043",
      "name": "Save items",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        3120,
        340
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select feed_items_save($1, $2::jsonb, $3) as saved",
        "options": {
          "largeNumbersOutput": "numbers",
          "queryReplacement": "={{ ((a) => a.map((v, i) => [1].includes(i) && v !== null && typeof v === 'object' ? JSON.stringify(v) : v))([ $json.source_id, $json.items, $json.error ]) }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "acfCredPostgres1",
          "name": "ACF Postgres (app_n8n)"
        }
      }
    }
  ],
