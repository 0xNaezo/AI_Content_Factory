  "nodes": [
    {
      "id": "b6dd8e38-0aeb-5a9a-8b94-8ba8a10333db",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -420,
        -40
      ],
      "parameters": {
        "content": "## DG · Feeds\n**Purpose**: read the brand RSS sources (DG-2), keep new items with relevance = cosine similarity between the item and the brand description embeddings; the digest builder takes the most relevant unused ones.\n**Input**: job {brand_id}.\n**AI**: embed (brand budget).",
        "height": 160,
        "width": 380,
        "color": 7
      }
    },
    {
      "id": "a1a8dbde-713f-5e35-a7d7-bad6ee6fff4e",
      "name": "Job",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "7c48d684-f16a-53ae-8060-73c3d86e97b1",
      "name": "Context",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select feeds_context($1) as c",
        "options": {
          "largeNumbersOutput": "numbers",
          "queryReplacement": "={{ [ $json.brand_id ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "acfCredPostgres1",
          "name": "ACF Postgres (app_n8n)"
        }
      }
    },
    {
      "id": "c1aae18c-1e1c-51e8-bc47-76e589812bb8",
      "name": "Sources?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "3ad72df5-1395-50e4-9d50-9d30c9e464ee",
              "leftValue": "={{ !!(($json.c.sources || []).length > 0 && $json.c.brand_text) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "1e1f431d-8001-5cf1-8445-80e7b8dbbec8",
      "name": "AI input: brand vector",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        170
      ],
      "parameters": {
        "jsCode": "const c = $json.c; return { json: { route: 'embed', input: c.brand_text, account_type: 'brand', brand_id: c.brand_id, job_id: $('Job').first().json.id } };\n",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "8fb6b731-2b04-516f-9c3b-ffef7f24cb49",
      "name": "AI: brand vector",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        960,
        170
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "acfAiGateway0001",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "a765a9c4-8df5-545f-b600-24f0005aebfe",
      "name": "Source list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        170
      ],
      "parameters": {
        "jsCode": "return $('Context').first().json.c.sources.map((s) => ({ json: s }));\n"
      }
    },
    {
      "id": "3aea952f-de81-5df6-82cc-a0a112786721",
      "name": "Source loop",
      "type": "n8n-nodes-base.splitInBatches",
