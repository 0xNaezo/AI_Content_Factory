      "parameters": {
        "jsCode": "const c = $('Context').first().json.c;\nconst brief = $('AI: brief').isExecuted ? $('AI: brief').first().json.result.brief : c.brief;\nconst v = c.vars || {};\nconst prompt = [brief, v.image_style ? 'Style: ' + v.image_style : null,\n  (v.palette || []).length ? 'Brand colors: ' + v.palette.join(', ') : null,\n  'Avoid: ' + [c.system_forbidden, ...(v.forbidden || [])].join(' ')].filter(Boolean).join('\\n');\nconst aspects = c.aspects || ['16:9'];\nreturn [{ json: { route: 'image.generate', prompt, aspect_ratio: aspects.includes('16:9') ? '16:9' : aspects[0],\n  account_type: c.account_type, brand_id: c.brand_id, material_id: c.material_id, package_id: c.package_id, job_id: $('Job').first().json.id } }];\n"
