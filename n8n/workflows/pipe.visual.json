      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst out = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const buf = await this.helpers.getBinaryDataBuffer(i, 'data');\n  out.push({ json: { sha256: crypto.createHash('sha256').update(buf).digest('hex'), bytes: buf.length }, binary: items[i].binary, pairedItem: i });\n}\nreturn out;\n"
