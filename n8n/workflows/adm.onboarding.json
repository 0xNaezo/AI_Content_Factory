{
  "id": "acfOnboarding001",
  "name": "ADM · Onboarding",
  "nodes": [
    {
      "id": "839f4dbb-def6-5aeb-b7c3-4d98cf7ba5d7",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -420,
        -40
      ],
      "parameters": {
        "content": "## ADM · Onboarding\n**Purpose**: draft brand profile from 5–10 sample posts (BP-3): link samples are read by the extractor, the draft is schema-constrained and validated, saved as a draft version and sent to the manager as YAML to edit and activate.\n**Input**: job {brand_id, payload.user_id}.\n**AI**: onboarding.profile (system budget).",
        "height": 160,
        "width": 380,
        "color": 7
      }
    },
    {
      "id": "f7ade85e-6b51-5491-9d25-0fe3266b259e",
      "name": "Job",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "874c8552-9e00-5a4a-ace9-cf9fe385212c",
      "name": "Context",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select onboarding_context($1) as c",
        "options": {
          "largeNumbersOutput": "numbers",
          "queryReplacement": "={{ [ $json.brand_id ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "acfCredPostgres1",
          "name": "ACF Postgres (app_n8n)"
        }
      }
    },
    {
      "id": "bafdd206-6cfd-52da-aed6-fa95d853e419",
      "name": "Links to read",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "const c = $input.first().json.c;\nconst links = c.samples.filter((s) => s.kind === 'url' && !s.text).map((s) => ({ json: { ...s, extractor_base: c.extractor_base } }));\nreturn links.length ? links : [{ json: { none: true } }];\n"
      }
    },
    {
      "id": "ca1fafbc-b58c-5d53-91b4-fa6ac2e83597",
      "name": "No links?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "40021597-f1d1-5806-abaf-aa9c5a4b0a72",
              "leftValue": "={{ !!($json.none) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "04c86df4-c805-5d46-aef6-bc68e39cf074",
      "name": "Read link",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        -170
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.extractor_base }}/url",
        "options": {
          "timeout": 45000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ url: $json.content }) }}"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "03b1d3fd-60b2-5dea-974c-38affd489a26",
      "name": "Save sample",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1200,
        -170
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select onboarding_sample_text($1, $2)",
        "options": {
          "largeNumbersOutput": "numbers",
          "queryReplacement": "={{ [ $('Links to read').item.json.id, $json.body?.ok ? ($json.body.title + '\\n\\n' + $json.body.text) : ('(could not read ' + $('Links to read').item.json.content + ')') ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "acfCredPostgres1",
          "name": "ACF Postgres (app_n8n)"
        }
      }
    },
    {
      "id": "fd6f025a-ed11-5954-a653-c633ab7b052c",
      "name": "Samples",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1200,
        170
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select onboarding_context($1) as c",
        "options": {
          "largeNumbersOutput": "numbers",
          "queryReplacement": "={{ [ $('Job').first().json.brand_id ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "acfCredPostgres1",
          "name": "ACF Postgres (app_n8n)"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "id": "17053b5a-a66b-5af0-8bc8-57d575ac7eab",
      "name": "AI input: draft profile",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        170
      ],
      "parameters": {
        "jsCode": "const c = $json.c;\nreturn { json: { route: 'onboarding.profile', account_type: 'system', job_id: $('Job').first().json.id,\n  vars: { brand_name: c.name, samples: c.samples.map((s) => s.text || s.content) } } };\n",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "adbb9b07-9095-5d3a-985f-be827f2f6ceb",
      "name": "AI: draft profile",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1680,
        170
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "acfAiGateway0001",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "97dcea9a-4706-56d9-93cc-4a0d361a83e4",
      "name": "Validate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
        170
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Samples').first().json.c.extractor_base }}/validate/brand-profile",
        "options": {
          "timeout": 20000
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ data: $json.result }) }}"
      },
      "onError": "stopWorkflow"
    },
    {
      "id": "9439a193-c530-5032-b1e4-59f1f43f66e6",
      "name": "Save draft",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        2160,
        170
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select onboarding_draft_saved($1, $2, $3::jsonb, $4::jsonb) as r",
        "options": {
          "largeNumbersOutput": "numbers",
          "queryReplacement": "={{ ((a) => a.map((v, i) => [2, 3].includes(i) && v !== null && typeof v === 'object' ? JSON.stringify(v) : v))([ $('Job').first().json.brand_id, $('Job').first().json.payload.user_id, $('AI: draft profile').first().json.result, $json.errors ?? [] ]) }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "acfCredPostgres1",
          "name": "ACF Postgres (app_n8n)"
        }
      }
    }
