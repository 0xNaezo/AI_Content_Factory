      "parameters": {
        "content": "## ADM · Housekeeping\n**Purpose**: privacy and cleanup: expired guest materials and temporary brands (with their S3 files), old sessions, tokens, sent outbox rows and processed inbound events.\n**Input**: housekeeping job (daily).",
        "height": 160,
        "width": 380,
        "color": 7
      }
    },
    {
      "id": "565737bb-638c-5f43-a2a3-329ab6f43c59",
