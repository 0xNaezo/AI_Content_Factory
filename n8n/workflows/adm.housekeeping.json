      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "return ($json.r.s3_keys || []).map((key) => ({ json: { key, bucket: $('Clean').first().json.r.bucket } }));\n"
      }
    },
    {
      "id": "ad721203-22fa-5f64-88f3-e4b32f6ccf81",
