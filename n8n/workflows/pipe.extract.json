        1200,
        -170
      ],
      "parameters": {
        "jsCode": "const c = $('Context').first().json.c;\nif ($json.error || !$json.statusCode || $json.statusCode >= 500) throw new Error('provider_unavailable: extractor is not reachable');\nconst b = $json.body || {};\nreturn { json: b.ok\n  ? { text: (b.title ? b.title + '\\n\\n' : '') + b.text, meta: { title: b.title, url: b.url, chars: b.meta?.chars ?? null }, error: null }\n  : { text: null, meta: {}, error: `Could not read the link ${c.url}: ${b.error || 'HTTP ' + $json.statusCode}` } };\n",
        "mode": "runOnceForEachItem"
      }
    },
