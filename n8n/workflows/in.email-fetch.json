{
  "id": "acfEmailFetch001",
  "name": "IN · Email fetch",
  "nodes": [
    {
      "id": "0d6e688b-62dc-5912-8dc1-cf0e9b3510ab",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -420,
        -40
      ],
      "parameters": {
        "content": "## IN · Email fetch\n**Purpose**: fetch a received email and its attachments from Resend, store files in S3, then intake_email(): sender by personal address in+<token>@…, limits (IN-2), material + parts, acknowledgement by email (IN-4); questions go to Telegram.\n**Input**: job {payload.event_id, payload.email_id}.",
        "height": 160,
        "width": 380,
        "color": 7
      }
    },
    {
      "id": "967563ee-5854-563e-863d-2edac26b9dec",
      "name": "Job",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "27063f08-a5a6-52be-b7a4-af849e74fca7",
      "name": "Context",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select email_fetch_context($1) as c",
        "options": {
          "largeNumbersOutput": "numbers",
          "queryReplacement": "={{ [ $json.payload.event_id ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "acfCredPostgres1",
          "name": "ACF Postgres (app_n8n)"
        }
      }
    },
    {
