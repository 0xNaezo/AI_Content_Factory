{
  "id": "acfHealth0000001",
  "name": "ADM · Health",
  "nodes": [
    {
      "id": "8c248c00-a1bb-598a-93e9-52d6dc657ac9",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -420,
        -40
      ],
      "parameters": {
        "content": "## ADM · Health\n**Purpose**: AD-5 alerts (queue depth and age, dead jobs, AI and publishing error rates) and the dead man's switch heartbeat (settings health.heartbeat_url) — if n8n or the queue stops, the external monitor alerts.\n**Input**: health.check job (every 5 min).",
        "height": 160,
        "width": 380,
        "color": 7
      }
    },
    {
      "id": "03c9a9e8-f290-5051-914a-39ff2b6f3dd6",
      "name": "Job",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "517544db-58cb-5ab1-909a-7077f43e5e50",
      "name": "Check",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select health_check() as h",
        "options": {
          "largeNumbersOutput": "numbers"
        }
      },
      "credentials": {
        "postgres": {
          "id": "acfCredPostgres1",
          "name": "ACF Postgres (app_n8n)"
        }
      }
    },
    {
      "id": "375780ea-065b-5cb0-8fdb-4d0400eeb823",
      "name": "Heartbeat?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "efdab9ef-e483-514f-a4f1-e5c104bff61d",
              "leftValue": "={{ !!($json.h.heartbeat_url) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "c50158b9-5178-5f54-82f2-b3d1ec145f8c",
      "name": "Ping",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.h.heartbeat_url }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Job": {
      "main": [
        [
          {
            "node": "Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check": {
      "main": [
        [
          {
            "node": "Heartbeat?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Heartbeat?": {
      "main": [
        [
          {
            "node": "Ping",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "saveExecutionProgress": false,
    "errorWorkflow": "acfErrorHandler1"
  },
  "active": false,
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": true
  }
}
