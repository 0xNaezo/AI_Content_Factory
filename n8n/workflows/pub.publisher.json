      "name": "Get photo",
      "type": "n8n-nodes-base.s3",
      "typeVersion": 1,
      "position": [
        720,
        0
      ],
      "parameters": {
        "resource": "file",
        "operation": "download",
        "bucketName": "={{ $json.request.bucket }}",
        "fileKey": "={{ $json.request.photo_s3_key }}",
