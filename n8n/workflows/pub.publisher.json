    {
      "id": "74aec2a5-87e6-50bd-a187-951c18438a38",
      "name": "Outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "jsCode": "// Telegram answer -> publish outcome (PB-4..PB-6). No answer after sending = unknown: never retried automatically.\nconst claim = $('Claim').item.json;\nconst r = $json;\nconst b = r.body;\nlet outcome, error = null, ext = null, url = null, fileId = null;\nif (r.error || !r.statusCode) {\n  const m = String(r.error?.message || r.error || 'no response');\n  outcome = /ECONNREFUSED|ENOTFOUND|EAI_AGAIN/i.test(m) ? 'failed' : 'unknown';\n  error = m.slice(0, 500);\n} else if (r.statusCode === 200 && b && b.ok) {\n  const msg = b.result;\n  outcome = 'ok';\n  ext = msg.chat.id + ':' + msg.message_id;\n  url = msg.chat.username ? `https://t.me/${msg.chat.username}/${msg.message_id}` : `https://t.me/c/${String(msg.chat.id).replace(/^-100/, '')}/${msg.message_id}`;\n  if (Array.isArray(msg.photo) && msg.photo.length) fileId = msg.photo[msg.photo.length - 1].file_id;\n} else {\n  outcome = 'failed';\n  error = `HTTP ${r.statusCode}: ${b?.description || JSON.stringify(b ?? '').slice(0, 300)}`;\n}\nreturn { json: { attempt_id: claim.attempt_id, outcome, http: r.statusCode || null, ext, url, error, fileId } };\n",
        "mode": "runOnceForEachItem"
      }
    },
