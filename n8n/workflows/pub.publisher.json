    {
      "id": "717a0ada-6732-5b25-b997-98cc969b8432",
      "name": "Photo request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "jsCode": "const q = $json.request; return { json: { api: q.api_base, request: { body: { chat_id: q.chat_id, caption: q.text, parse_mode: 'HTML' }, upload: { field: 'photo', filename: 'image.jpg', mime: q.photo_mime || 'image/jpeg' } } }, binary: $input.item.binary };\n",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "7ff2e478-f2e8-59d1-8813-8c535e8b3ad0",
      "name": "Multipart",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "jsCode": "const out = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const { body: fields, upload: file } = items[i].json.request;\n  const form = Object.entries(fields)\n    .filter(([, v]) => v !== null && v !== undefined && v !== '')\n    .map(([name, v]) => ({ name, value: typeof v === 'object' ? JSON.stringify(v) : String(v) }));\n  if (form.length > 6) throw new Error('too many form fields for the upload node: ' + form.length);\n  while (form.length < 6) form.push({ name: '_pad' + form.length, value: '' });\n  const content = file.text != null ? Buffer.from(file.text, 'utf8') : await this.helpers.getBinaryDataBuffer(i, 'data');\n  out.push({ json: { ...items[i].json, form, form_file: file.field },\n             binary: { file: await this.helpers.prepareBinaryData(content, file.filename, file.mime) }, pairedItem: i });\n}\nreturn out;\n"
      }
    },
    {
      "id": "6ded2b22-3102-55f5-a7b0-0b808df34b73",
      "name": "Send photo file",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.api }}/sendPhoto",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "={{ $json.form_file }}",
              "inputDataFieldName": "file"
            },
            {
