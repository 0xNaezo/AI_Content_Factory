    {
      "id": "ef8f409a-9231-51f4-bd7d-25b012adaa66",
      "name": "AI input: feed block",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        170
      ],
      "parameters": {
        "jsCode": "const c = $('Context').first().json.c;\nreturn { json: { route: 'digest.feed_block', vars: { brand_name: c.vars.brand_name, voice: c.vars.voice, language: c.vars.language, item: $json },\n  account_type: 'brand', brand_id: c.brand_id, job_id: $('Job').first().json.id } };\n",
        "mode": "runOnceForEachItem"
      }
    },
    {
