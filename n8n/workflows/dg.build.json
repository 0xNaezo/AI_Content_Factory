    {
      "id": "69087e11-600c-5915-9b0d-f032a882f3bd",
      "name": "Feed block",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        170
      ],
      "parameters": {
        "jsCode": "const f = $('Feed loop').first().json; const r = $json.result; return { json: { feed_item_id: f.feed_item_id, title: r.title, body: r.body, link_label: r.link_label, link_url: f.link } };\n",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "43cb2c1c-37ee-51e9-b9b9-75b59ecd991b",
      "name": "AI input: compose",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        510
      ],
      "parameters": {
        "jsCode": "const c = $('Context').first().json.c;\nconst feed = $('Feed loop').isExecuted ? $input.all().map((i) => i.json).filter((j) => j.feed_item_id) : [];\nconst blocks = [...c.variants, ...feed].map((b, index) => ({ index, ...b }));\nreturn [{ json: { route: 'digest.compose', account_type: 'brand', brand_id: c.brand_id, job_id: $('Job').first().json.id, _blocks: blocks,\n  vars: { brand_name: c.vars.brand_name, digest: c.vars.digest, voice: c.vars.voice, language: c.vars.language, period: c.vars.period,\n          blocks: blocks.map((b) => ({ index: b.index, title: b.title, body: b.body })) } } }];\n"
      }
    },
    {
      "id": "67926a08-5425-5473-ade4-e7fc404b49f6",
      "name": "AI: compose",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1680,
        510
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "acfAiGateway0001",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "8616cb90-5d48-552b-b0fc-a2302b5bf3ba",
      "name": "Render",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        510
      ],
      "parameters": {
        "jsCode": "// Issue HTML from templates/email/digest.html (mustache subset). {{unsubscribe_url}} stays literal: SQL fills it per subscriber.\nconst c = $('Context').first().json.c;\nconst blocks = $('AI input: compose').first().json._blocks;\nconst comp = $input.first().json.result;\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst html = (s) => esc(s).replace(/\\n/g, '<br>');\nfunction render(tpl, ctx) {\n  tpl = tpl.replace(/\\{\\{([#^])(\\w+)\\}\\}([\\s\\S]*?)\\{\\{\\/\\2\\}\\}/g, (_, t, k, inner) => {\n    const v = ctx[k];\n    const empty = !v || (Array.isArray(v) && v.length === 0);\n    if (t === '^') return empty ? render(inner, ctx) : '';\n    if (Array.isArray(v)) return v.map((x) => render(inner, { ...ctx, ...x })).join('');\n    return empty ? '' : render(inner, ctx);\n  });\n  return tpl.replace(/\\{\\{\\{(\\w+)\\}\\}\\}/g, (_, k) => ctx[k] ?? '').replace(/\\{\\{(\\w+)\\}\\}/g, (_, k) => esc(ctx[k]));\n}\nconst order = [...new Set((comp.order || []).filter((i) => Number.isInteger(i) && i >= 0 && i < blocks.length))];\nblocks.forEach((_, i) => { if (!order.includes(i)) order.push(i); });\nconst ordered = order.map((i) => blocks[i]);\nconst d = c.vars.digest || {};\nconst cta = comp.cta || d.cta || null;\nconst out = render(c.template, {\n  language: c.vars.language || 'en', subject: comp.subject, preheader: comp.preheader, color: (c.palette || [])[0] || '#18181b',\n  digest_title: d.title || c.vars.brand_name, brand_name: c.vars.brand_name, period: c.vars.period, intro_html: html(comp.intro),\n  blocks: ordered.map((b) => ({ title: b.title, body_html: html(b.body), link_url: b.link_url, link_label: b.link_label || 'Read more',\n    image_url: b.image_asset_id ? `${c.web_url}/media/${b.image_asset_id}?t=${c.preview_token}` : null })),\n  cta_url: cta?.url || null, cta_text: cta?.text || null, footer_text: d.footer_text || '', blog_url: c.blog_url,\n  unsubscribe_url: '{{unsubscribe_url}}' });\nreturn [{ json: { compose: comp, items: ordered.map(({ index, ...b }) => b), html: out } }];\n"
      }
    },
