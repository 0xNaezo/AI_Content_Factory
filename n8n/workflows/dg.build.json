      "typeVersion": 1.2,
      "position": [
        1680,
        170
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "acfAiGateway0001",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
