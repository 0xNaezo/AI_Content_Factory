      "position": [
        1680,
        340
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select profile_import($1, $2, null, $3::jsonb) as r",
        "options": {
          "largeNumbersOutput": "numbers",
          "queryReplacement": "={{ ((a) => a.map((v, i) => [2].includes(i) && v !== null && typeof v === 'object' ? JSON.stringify(v) : v))([ $('Job').first().json.brand_id, $('Job').first().json.payload.user_id, [ 'YAML syntax error' + ($json.line ? ' at line ' + $json.line : '') + ': ' + $json.error ] ]) }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "acfCredPostgres1",
