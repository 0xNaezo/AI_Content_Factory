      "position": [
        1200,
        170
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select post_op_result($1, $2, $3, $4) as flags",
        "options": {
          "largeNumbersOutput": "numbers",
          "queryReplacement": "={{ [ $('Job').first().json.id, ($json.statusCode === 200 && !!$json.body?.ok) || String($json.body?.description || '').toLowerCase().includes('not modified'), $json.statusCode || 0, String($json.body?.description || $json.error?.message || $json.error || '') || null ] }}"
        }
      },
      "credentials": {
