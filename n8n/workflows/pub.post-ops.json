        "query": "select post_op_context($1) as c",
        "options": {
          "largeNumbersOutput": "numbers",
          "queryReplacement": "={{ [ $json.id ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "acfCredPostgres1",
          "name": "ACF Postgres (app_n8n)"
        }
      }
    },
    {
