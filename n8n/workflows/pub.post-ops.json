      }
    },
    {
      "id": "c0ffff9b-6304-5d74-9861-3f4dbae3b5c9",
      "name": "Call Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        170
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.c.api_base }}/{{ $json.c.method }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.c.body) }}"
      },
      "onError": "continueRegularOutput"
