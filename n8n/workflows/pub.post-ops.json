            "version": 2
          },
          "conditions": [
            {
              "id": "d7699c91-841f-56c8-8f38-f6e84e8d58d5",
              "leftValue": "={{ !!($json.c.skip) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
